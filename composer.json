{
    "name": "phasync/swerve-laravel",
    "description": "Run Laravel applications on swerve: booted once per worker, WebSockets and Server-Sent Events, no rewrite.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "swerve", "phasync", "application server", "long-running", "psr-15", "websocket", "octane"],
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "phasync/swerve": "^0.1.0-alpha15",
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/octane": "^2.12",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0 || ^4.0",
        "friendsofphp/php-cs-fixer": "^3.58"
    },
    "autoload": {
        "psr-4": {
            "Swerve\\Laravel\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest --stop-on-defect",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix --verbose",
        "php-cs-fixer-dry-run": "vendor/bin/php-cs-fixer fix --verbose --diff --dry-run"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
