{
    "name": "phasync/swerve-laravel",
    "description": "Run Laravel applications on swerve: a fresh application per request, WebSockets and Server-Sent Events, no rewrite.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "swerve", "phasync", "application server", "long-running", "websocket"],
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "phasync/babel": "@dev",
        "phasync/hooked": "@dev",
        "phasync/phasync": "^2.0",
        "phasync/plug": "@dev",
        "phasync/swerve": "dev-modes",
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/octane": "^2.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0 || ^4.0",
        "friendsofphp/php-cs-fixer": "^3.58"
    },
    "autoload": {
        "psr-4": {
            "Swerve\\Laravel\\": "src/"
        },
        "files": [
            "src/functions.php",
            "src/integrate-with-swerve.php"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "/home/frode/dev/swerve-modes",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "/home/frode/dev/phasync-plug",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "/home/frode/dev/phasync-babel",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "/home/frode/dev/phasync-hooked",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest --stop-on-defect",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix --verbose",
        "php-cs-fixer-dry-run": "vendor/bin/php-cs-fixer fix --verbose --diff --dry-run"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
